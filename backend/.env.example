# Copy to .env and adjust. NEVER commit the real .env file.
APP_ENV=development
# SQLite is the zero-setup default; PostgreSQL is the target database:
# DATABASE_URL=postgresql+psycopg2://taxwatch:taxwatch@localhost:5432/taxwatch
DATABASE_URL=sqlite:///./taxwatch.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_MINUTES=60
ANOMALY_THRESHOLD=50000000
CORS_ORIGINS=http://localhost:3000
